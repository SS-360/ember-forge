# Copy to .env. Keep credentials server-side; never place them in apps/web.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_API_KEY=
NVIDIA_ACCOUNT_REFERENCE=

# Zetaris: use your deployment's documented client/API endpoint, not the AWS account ID.
# SaaS REST authentication is documented at https://kbase.zetaris.com/knowledge/accessing-zetaris-using-api
# AWS-hosted Gateway/JDBC deployments can have a different client contract; confirm it first.
# These are configuration placeholders; no live tenant transport is enabled.
ZETARIS_BASE_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Local Docker/JDBC route (separate from SaaS API-key authentication).
ZETARIS_JDBC_URL=
ZETARIS_JDBC_DRIVER_JAR=

# Current user authorization is $0. Environment configuration does not enable provider calls.
# Free entitlement or a different explicit authorization must be confirmed before server composition changes.
NVIDIA_SESSION_BUDGET_USD=0

# Bundled Meterless H-MEM is local and requires no API credential.

