# Copy to .env. Keep credentials server-side; never place them in apps/web.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_API_KEY=
NVIDIA_ACCOUNT_REFERENCE=

# Zetaris tenant-specific values; endpoints are intentionally not guessed.
ZETARIS_BASE_URL=
ZETARIS_API_KEY=

# Current user authorization is $0. Environment configuration does not enable provider calls.
# Free entitlement or a different explicit authorization must be confirmed before server composition changes.
NVIDIA_SESSION_BUDGET_USD=0

