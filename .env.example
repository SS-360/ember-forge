# Copy to .env. Keep credentials server-side; never place them in apps/web.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_API_KEY=

# Zetaris tenant-specific values; endpoints are intentionally not guessed.
ZETARIS_BASE_URL=
ZETARIS_API_KEY=

# Hard ceiling for billable NVIDIA API usage per local session, in USD.
NVIDIA_SESSION_BUDGET_USD=

